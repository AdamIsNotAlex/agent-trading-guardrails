FROM node:22.23.4-bookworm-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends 'ca-certificates>=20250419~deb12u2' && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages/ ./packages/

RUN corepack enable && pnpm install --frozen-lockfile && pnpm build

FROM node:22.23.4-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends 'ca-certificates>=20250419~deb12u2' && rm -rf /var/lib/apt/lists/*

RUN groupadd -r -g 999 guardrail && useradd -r -u 999 -g guardrail -s /bin/false guardrail \
    && mkdir -p /app/data /app/audit-anchor /app/approvals \
    && chmod 0700 /app/data /app/audit-anchor /app/approvals \
    && chown -R guardrail:guardrail /app/data /app/audit-anchor /app/approvals

WORKDIR /app

COPY --from=builder /app ./

USER guardrail

ENV NODE_ENV=production
ENV GUARDRAIL_HOST=0.0.0.0

EXPOSE 3000

CMD ["node", "packages/runtime/dist/service-main.js"]
