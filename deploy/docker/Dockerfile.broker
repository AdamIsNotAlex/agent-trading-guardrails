FROM node:22-slim AS builder

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages/ ./packages/

RUN corepack enable && pnpm install --frozen-lockfile && pnpm build

FROM node:22-slim AS runtime

RUN groupadd -r -g 999 broker && useradd -r -u 999 -g broker -s /bin/false broker \
    && mkdir -p /app/data /app/audit-anchor /app/approvals \
    && chmod 0700 /app/data /app/audit-anchor /app/approvals \
    && chown -R broker:broker /app/data /app/audit-anchor /app/approvals

WORKDIR /app

COPY --from=builder /app ./

USER broker

ENV NODE_ENV=production
ENV BROKER_HOST=0.0.0.0

EXPOSE 3001

CMD ["node", "packages/runtime/dist/broker-main.js"]
