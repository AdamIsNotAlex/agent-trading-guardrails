FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx-light 'ca-certificates>=20250419~deb12u2' logrotate \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/log/nginx \
    && chown -R www-data:www-data /var/log/nginx

COPY deploy/proxy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/proxy/logrotate.conf /etc/guardrails-logrotate.conf
COPY deploy/proxy/start.sh /usr/local/bin/start-egress

USER www-data
EXPOSE 8080 8081
ENTRYPOINT ["sh", "/usr/local/bin/start-egress"]
