{
  "name": "agent-trading-guardrails",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "package:plugins": "pnpm build && pnpm --filter @guardrails/agent-adapters package:plugins",
    "start:service": "node --env-file-if-exists=.env packages/runtime/dist/service-main.js",
    "start:broker": "node --env-file-if-exists=.env packages/runtime/dist/broker-main.js",
    "start:approval": "node --env-file-if-exists=.env packages/runtime/dist/approval-main.js",
    "start:canary-dry-run": "node --env-file-if-exists=.env packages/runtime/dist/canary-dry-run-main.js",
    "start:signer": "node --env-file-if-exists=.env packages/runtime/dist/signer-main.js",
    "start:sign": "node --env-file-if-exists=.env packages/runtime/dist/sign-main.js",
    "start:agent": "node packages/agent-adapters/dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:sandbox": "vitest run -c vitest.sandbox.config.ts",
    "test:containers": "node deploy/test-containers.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -b",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "^4.1.8",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
