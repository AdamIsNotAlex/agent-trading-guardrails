# Environment profile: dev | paper | testnet | canary_live | production
GUARDRAIL_ENV=dev

# Standalone HTTP listeners (loopback unless explicitly deployed on a private network)
GUARDRAIL_HOST=127.0.0.1
GUARDRAIL_PORT=3000
BROKER_HOST=127.0.0.1
BROKER_PORT=3001
SIGNER_HOST=127.0.0.1
SIGNER_PORT=3002
# Inject only the needed Guardrail connection settings into Agent, never this whole file.
GUARDRAIL_URL=http://127.0.0.1:3000
# Operator dry-run only; never inject the execution endpoint into Agent.
BROKER_URL=http://127.0.0.1:3001
# Native Hermes plugin settings (OpenClaw uses its own plugin config instead).
GUARDRAIL_PRINCIPAL=agent.hermes.strategy-beta
GUARDRAIL_TIMEOUT_MS=30000
# GUARDRAIL_NODE_BINARY=/absolute/path/to/node

# OPA
OPA_URL=http://localhost:8181

# Guardrail decision and audit signing secrets (use high-entropy values outside dev)
GUARDRAIL_DECISION_SECRET=dev-decision-secret
AUDIT_HASH_SECRET=dev-audit-hash-secret

# Vault (dev server only — never use dev mode in production)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=replace-me-dev-only

# Binance credentials stay in trusted Guardrail/Broker processes, never Agent.
# Use separate read-only risk and trading keys for the same dedicated account.
# Secret-manager injection may set BINANCE_API_KEY_FILE/BINANCE_API_SECRET_FILE instead.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_ACCOUNT=subaccount-1
BINANCE_ACCOUNT_MODE=spot
BINANCE_SYMBOLS=ETH-USDC
# Exhaustive history universe, including symbols disabled for new orders.
BINANCE_HISTORY_SYMBOLS=ETH-USDC
BINANCE_MAX_FUTURES_LEVERAGE=1
# Required for mainnet: this trusted process's egress IPs, also configured on its Binance key.
# No wildcard addresses/CIDRs. Testnet deliberately does not query mainnet SAPI.
BINANCE_IP_ALLOWLIST=

# Dedicated Spot sandbox acceptance credentials, only read by pnpm test:sandbox.
# Export explicitly for that command; tests do not load this .env file automatically.
# Never set these in Agent or reuse production keys. No credentials means a visible skip.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Reviewer
REVIEWER_PROVIDER=openai
REVIEWER_MODEL=gpt-5.5
OPENAI_API_KEY=

# file: trusted atomic JSON snapshot; binance: on-demand signed exchange risk data.
# Default Compose deliberately stays file/paper and has no exchange egress.
RISK_DATA_PROVIDER=file
RISK_DATA_PATH=./data/risk/risk-snapshot.json

# paper permits dev/paper only; binance permits testnet or explicitly enabled canary_live.
BROKER_CONNECTOR=paper
BROKER_CANARY_LIVE_ENABLED=false
BROKER_IDEMPOTENCY_PATH=./data/broker-idempotency.json
BROKER_KILL_SWITCH=false

# Local offline Sepolia signing only; never fund or reuse generated sandbox keys.
# Compose overrides these with signer-only volumes and the private execution address.
SIGNER_URL=http://127.0.0.1:3002
SIGNER_KEY_PATH=./data/signer/sepolia.key
SIGNER_AUDIT_DB_PATH=./data/signer-audit.db
SIGNER_AUDIT_HASH_ANCHOR_PATH=./audit-anchor/signer/head.hash
# Integer decimal gas/wei caps; aggregate gas * maxFeePerGas must also fit the ceiling.
SIGNER_MAX_GAS=1000000
SIGNER_MAX_FEE_PER_GAS=100000000000
SIGNER_MAX_TOTAL_FEE_WEI=10000000000000000

# Separate audit databases/anchors: each hash chain must have exactly one writer.
GUARDRAIL_AUDIT_DB_PATH=./data/guardrail-audit.db
BROKER_AUDIT_DB_PATH=./data/broker-audit.db
# Required outside dev/test; keep anchors outside the database directory and back them up.
GUARDRAIL_AUDIT_HASH_ANCHOR_PATH=./audit-anchor/guardrail/head.hash
BROKER_AUDIT_HASH_ANCHOR_PATH=./audit-anchor/broker/head.hash

# Shared SQLite used by guardrail, broker, and the operator CLI. Do not point this at an audit DB.
APPROVAL_DB_PATH=./data/approvals.db
APPROVAL_TIMEOUT_SECONDS=300
# Operator CLI audit chain only — never reuse guardrail/broker audit files or APPROVAL_DB_PATH.
APPROVAL_AUDIT_DB_PATH=./data/approval-audit.db
APPROVAL_AUDIT_HASH_ANCHOR_PATH=./audit-anchor/approval/head.hash
# Optional CLI allowlist onboarding file; omit to fail closed on allowlist_onboarding approvals.
# APPROVAL_ALLOWLIST_PATH=./data/approval-allowlist.json
