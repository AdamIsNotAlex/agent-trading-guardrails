# Environment profile: dev | paper | testnet | canary_live | production
GUARDRAIL_ENV=dev

# Standalone HTTP listeners (loopback unless explicitly deployed on a private network)
GUARDRAIL_HOST=127.0.0.1
GUARDRAIL_PORT=3000
BROKER_HOST=127.0.0.1
BROKER_PORT=3001
SIGNER_HOST=127.0.0.1
SIGNER_PORT=3002
# The agent receives only this URL, not this entire environment file.
GUARDRAIL_URL=http://127.0.0.1:3000

# OPA
OPA_URL=http://localhost:8181

# Guardrail decision and audit signing secrets (use high-entropy values outside dev)
GUARDRAIL_DECISION_SECRET=dev-decision-secret
AUDIT_HASH_SECRET=dev-audit-hash-secret

# Vault (dev server only — never use dev mode in production)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=replace-me-dev-only

# Binance (no real keys — use Vault in non-dev environments)
BINANCE_API_KEY=your-api-key-here
BINANCE_API_SECRET=your-api-secret-here
BINANCE_TESTNET=true

# Reviewer
REVIEWER_PROVIDER=openai
REVIEWER_MODEL=gpt-5.5
OPENAI_API_KEY=

# Trusted, atomically updated risk feed; missing/stale/invalid facts fail closed.
RISK_DATA_PATH=./data/risk/risk-snapshot.json

# Standalone broker uses simulated execution in dev/paper only.
BROKER_IDEMPOTENCY_PATH=./data/broker-idempotency.json
BROKER_KILL_SWITCH=false

# Local offline Sepolia signing only; never fund or reuse generated sandbox keys.
# Compose overrides these with signer-only volumes and the private execution address.
SIGNER_URL=http://127.0.0.1:3002
SIGNER_KEY_PATH=./data/signer/sepolia.key
SIGNER_AUDIT_DB_PATH=./data/signer-audit.db
SIGNER_AUDIT_HASH_ANCHOR_PATH=./audit-anchor/signer/head.hash
# Integer decimal gas/wei caps; aggregate gas * maxFeePerGas must also fit the ceiling.
SIGNER_MAX_GAS=1000000
SIGNER_MAX_FEE_PER_GAS=100000000000
SIGNER_MAX_TOTAL_FEE_WEI=10000000000000000

# Separate audit databases/anchors: each hash chain must have exactly one writer.
GUARDRAIL_AUDIT_DB_PATH=./data/guardrail-audit.db
BROKER_AUDIT_DB_PATH=./data/broker-audit.db
# Required outside dev/test; keep anchors outside the database directory and back them up.
GUARDRAIL_AUDIT_HASH_ANCHOR_PATH=./audit-anchor/guardrail/head.hash
BROKER_AUDIT_HASH_ANCHOR_PATH=./audit-anchor/broker/head.hash

# Human Approval
APPROVAL_TIMEOUT_SECONDS=300
