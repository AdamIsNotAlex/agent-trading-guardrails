{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/dynamic-risk-result",
  "definitions": {
    "dynamic-risk-result": {
      "type": "object",
      "properties": {
        "intentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": ["pass", "fail", "unavailable"]
              },
              "value": {},
              "threshold": {},
              "message": {
                "type": "string"
              }
            },
            "required": ["check", "status"],
            "additionalProperties": false
          }
        },
        "dailyStats": {
          "type": "object",
          "properties": {
            "account": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "minLength": 1
            },
            "totalNotionalUsd": {
              "type": "number",
              "minimum": 0
            },
            "realizedLossUsd": {
              "type": "number",
              "minimum": 0
            },
            "orderCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["account", "date", "totalNotionalUsd", "realizedLossUsd", "orderCount"],
          "additionalProperties": false
        },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": ["intentId", "passed", "checks", "evaluatedAt"],
      "additionalProperties": false
    }
  }
}
