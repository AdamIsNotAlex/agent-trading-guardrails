{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/audit-event",
  "definitions": {
    "audit-event": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "eventType": {
          "type": "string",
          "enum": [
            "intent.received",
            "intent.validated",
            "intent.rejected",
            "reviewer.started",
            "reviewer.completed",
            "reviewer.failed",
            "policy.evaluated",
            "policy.failed",
            "risk.evaluated",
            "risk.failed",
            "decision.final",
            "decision.dry_run",
            "approval.requested",
            "approval.approved",
            "approval.denied",
            "approval.timeout",
            "allowlist.updated",
            "signer.requested",
            "signer.completed",
            "signer.failed",
            "broker.revalidated",
            "broker.preflight",
            "broker.dry_run",
            "broker.executed",
            "broker.failed",
            "killswitch.activated",
            "killswitch.blocked"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "environment": {
          "type": "string",
          "enum": ["dev", "paper", "testnet", "canary_live", "production"]
        },
        "intentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "principal": {
          "type": "string"
        },
        "promptId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "inputRef": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "previousHash": {
          "type": "string",
          "minLength": 1
        },
        "eventHash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "eventId",
        "eventType",
        "timestamp",
        "correlationId",
        "environment",
        "data",
        "previousHash",
        "eventHash"
      ],
      "additionalProperties": false
    }
  }
}
