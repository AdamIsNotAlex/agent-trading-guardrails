{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/cex-order-intent",
  "definitions": {
    "cex-order-intent": {
      "type": "object",
      "properties": {
        "intentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "principal": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "const": "cex.place_order"
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "enum": ["dev", "paper", "testnet", "canary_live", "production"]
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exchange": {
          "type": "string",
          "const": "binance"
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "accountMode": {
          "type": "string",
          "enum": ["spot", "usdm_futures"]
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "type": "string",
          "enum": ["buy", "sell"]
        },
        "orderType": {
          "type": "string",
          "enum": ["limit"]
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxNotionalUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxSlippageBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "leverage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "marginType": {
          "type": "string",
          "enum": ["isolated", "cross"]
        }
      },
      "required": [
        "intentId",
        "principal",
        "action",
        "resource",
        "environment",
        "requestedAt",
        "idempotencyKey",
        "rationale",
        "evidence",
        "exchange",
        "account",
        "accountMode",
        "symbol",
        "side",
        "orderType",
        "quantity",
        "price",
        "maxNotionalUsd",
        "maxSlippageBps"
      ],
      "additionalProperties": false
    }
  }
}
