{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/onchain-simulation-intent",
  "definitions": {
    "onchain-simulation-intent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "intentId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "principal": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "const": "onchain.simulate_transaction"
            },
            "resource": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": "string",
              "enum": ["dev", "paper", "testnet", "canary_live", "production"]
            },
            "requestedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "minItems": 1,
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "to": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "programId": {
              "type": "string"
            },
            "instructions": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "chain": {
              "type": "string",
              "const": "ethereum"
            },
            "chainEnvironment": {
              "type": "string",
              "enum": ["sepolia", "mainnet"]
            },
            "expectedDeltas": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string",
                    "minLength": 1
                  },
                  "asset": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minDelta": {
                    "type": "string",
                    "pattern": "^-?\\d+$"
                  },
                  "maxDelta": {
                    "type": "string",
                    "pattern": "^-?\\d+$"
                  }
                },
                "required": ["address", "asset", "minDelta", "maxDelta"],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "intentId",
            "principal",
            "action",
            "resource",
            "environment",
            "requestedAt",
            "idempotencyKey",
            "rationale",
            "evidence",
            "to",
            "chain",
            "chainEnvironment"
          ],
          "additionalProperties": false
        },
