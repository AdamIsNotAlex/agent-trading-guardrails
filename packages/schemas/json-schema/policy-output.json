{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/policy-output",
  "definitions": {
    "policy-output": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["allow", "deny", "needs_human"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["rule", "message"],
            "additionalProperties": false
          }
        },
        "requiresHumanApproval": {
          "type": "boolean"
        },
        "matchedAllowRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matchedDenyRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "decision",
        "reasons",
        "requiresHumanApproval",
        "matchedAllowRules",
        "matchedDenyRules",
        "evaluatedAt"
      ],
      "additionalProperties": false
    }
  }
}
